import ugradio
from ugradio import dft, sdr
import numpy as np
import time


sdr = ugradio.sdr.SDR(
    direct=True,
    device_index=0
)

def capture_sine_wave(sample_rate, filename, use_custom_fir=False):
    sdr = ugradio.sdr.SDR(direct=True, sample_rate=sample_rate)
    
    try:
        if use_custom_fir:
            fir_coeffs = np.array()
            sdr.set_fir_coeffs(fir_coeffs)
        
        # Clear stale buffers
        _ = sdr.capture_data() 
        
        # Actual data capture
        data = sdr.capture_data()
        
        np.savez(filename, data=data, sample_rate=sample_rate, timestamp=time.time())
        print(f"Data saved to {filename}")
        
    finally:
        sdr.close()



rates = [1.0e6, 2.0e6, 3.2e6]
for i, vs in enumerate(rates):
    capture_sine_wave(vs, f'trial_{i}.npz')


import numpy as np
import matplotlib.pyplot as plt

def analyze_capture(filename):
    # Load files with numpy.load [4]
    loaded = np.load(filename)
    data = loaded['data']
    vs = loaded['sample_rate']
    N = len(data)

    freqs = np.fft.fftfreq(N, 1/vs)
    spectrum = np.fft.fft(data)
    power_spec = np.abs(spectrum)**2

    plot_freqs = np.fft.fftshift(freqs)
    plot_power = np.fft.fftshift(power_spec)
    
    return plot_freqs, plot_power

# Load and Plot
freqs, power = analyze_capture('trial_0.npz')
plt.semilogy(freqs / 1e3, power) # Logarithmic axis to see spectral leakage [8]
plt.xlabel('Frequency (kHz)')
plt.ylabel('Power (Arbitrary Units)')
plt.title('Power Spectrum of Sine Wave')
plt.show()

