import ugradio
import numpy as np
import matplotlib.pyplot as plt

def capture_signals():
    sample_rates = [1.0e6, 2.0e6, 3.2e6] # 
    aliasing_fir = np.array() # 

    for vs in sample_rates:
        sdr = ugradio.sdr.SDR(direct=True, sample_rate=vs)
        
        try:
            _ = sdr.capture_data() 
            data_default = sdr.capture_data()
            np.savez(f'data_default_{vs}.npz', data=data_default, vs=vs) 

            sdr.set_fir_coeffs(aliasing_fir)
            data_aliased = sdr.capture_data()
            np.savez(f'data_aliased_{vs}.npz', data=data_aliased, vs=vs) # [3]
            
        finally:
            sdr.close()
